{
  "name": "@omarchy/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared tokens, themes and components for Alec's personal Astro + React apps.",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    "./styles.css": "./src/styles/index.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./compat.css": "./src/styles/compat.css",
    "./themes/*.css": "./src/styles/themes/*.css",
    "./astro/*": "./src/astro/*",
    "./core": "./src/core/index.ts",
    "./client/*": "./src/client/*",
    "./react": "./src/react/index.ts"
  },
  "peerDependencies": {
    "astro": ">=5 <8",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.0"
  }
}
