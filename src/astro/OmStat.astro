---
import type { NumberFormat } from "../core/format.ts";
import { formatNumber } from "../core/format.ts";
import { deltaModel } from "../core/delta.ts";

export interface Props {
  label: string;
  value: string | number | null;
  unit?: string;
  format?: NumberFormat;
  /** Renders a "?" affordance carrying this text. */
  hint?: string;
  /** Signed change. Direction is derived unless `goodDirection` says otherwise. */
  delta?: number | null;
  deltaFormat?: NumberFormat;
  /** Appended to the delta, e.g. "%" when the delta is a percentage change. */
  deltaUnit?: string;
  /** "up" (default) means a rise is good; "down" suits resting HR or spend. */
  goodDirection?: "up" | "down";
  /** "inline" (default) keeps the unit on the figure's line; "block" drops it
   *  underneath, which reads better for a long unit like "hours avg". */
  unitPlacement?: "inline" | "block";
  /** "card" (default) is a tile; "hero" is the page's one big figure, unboxed. */
  variant?: "card" | "hero";
  class?: string;
}

const {
  label,
  value,
  unit,
  format = "int",
  hint,
  delta = null,
  deltaFormat = "fixed1",
  deltaUnit = "",
  goodDirection = "up",
  unitPlacement = "inline",
  variant = "card",
  class: className,
} = Astro.props;

const display = value == null ? "–" : typeof value === "number" ? formatNumber(value, format) : value;

// "Good" is the app's call, not the arrow's: a falling resting HR is green.
const { direction, tone, arrow } = deltaModel(delta ?? 0, goodDirection);
---

<div
  class:list={[
    "om-stat",
    unitPlacement === "block" && "om-stat--unit-block",
    variant === "hero" && "om-stat--hero",
    className,
  ]}
>
  <div class="om-stat__label">
    <span>{label}</span>
    {hint && (
      <button class="om-stat__hint" type="button" data-om-tip={hint} aria-label={`${label} explained`}>?</button>
    )}
  </div>
  <div class="om-stat__value">
    {display}
    {unit && <span class="om-stat__unit">{unit}</span>}
    {delta != null && (
      <span class:list={["om-stat__delta", `om-stat__delta--${tone}`]}>
        <span aria-hidden="true">{arrow}</span>
        {direction !== "flat" && <span class="om-sr-only">{direction}</span>}
        <span>{formatNumber(Math.abs(delta), deltaFormat)}{deltaUnit}</span>
      </span>
    )}
  </div>
  <slot />
</div>

{/* The hint is a tooltip trigger, so the component that renders it is what
    mounts the tooltip. Astro bundles this once per page however many stats
    are on it. */}
<script>
  import { mountTips } from "../client/hover.ts";
  mountTips();
  document.addEventListener("astro:page-load", () => mountTips());
</script>
